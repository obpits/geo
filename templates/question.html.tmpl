<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Guess the Country</title>
<style>
  body { font-family: system-ui, sans-serif; background: #1e2530; color: #eee;
         display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
  .card { background: #2a3242; border-radius: 12px; padding: 2rem 2.5rem; width: 22rem; text-align: center; }
  .score { color: #9aa5b8; font-size: 0.9rem; margin-bottom: 1rem; }
  h1 { font-size: 1.1rem; color: #9aa5b8; margin: 0 0 0.25rem; font-weight: normal; }
  .city { font-size: 2rem; margin: 0 0 1.5rem; }
  button.option { display: block; width: 100%; margin: 0.5rem 0; padding: 0.75rem; font-size: 1rem;
         border: 1px solid #445; border-radius: 8px; background: #333e52; color: #eee; cursor: pointer; }
  button.option:hover { background: #445; }
</style>
</head>
<body>
  <div class="card">
    <div class="score">Score: {{.Score}} / {{.Total}}</div>
    <h1>Which country is this city in?</h1>
    <p class="city">{{.City}}</p>
    {{range .Options}}
    <form method="POST" action="/answer">
      <input type="hidden" name="answer" value="{{$.Answer}}">
      <input type="hidden" name="score" value="{{$.Score}}">
      <input type="hidden" name="total" value="{{$.Total}}">
      <button class="option" type="submit" name="choice" value="{{.}}">{{.}}</button>
    </form>
    {{end}}
  </div>
</body>
</html>
